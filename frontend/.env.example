# Copy to .env for local `npm run dev`. These values are also mirrored in the
# root .env.example — docker-compose passes them to the frontend image as
# build args (see frontend/Dockerfile) so the one-click deploy path uses the
# same credentials as local dev.
#
# DEMO-MOCKED: hardcoded login credentials, one set per role. There is no real
# auth/session backend behind this — see CLAUDE.md's auth scope.
VITE_PATIENT_USERNAME=patient_demo
VITE_PATIENT_PASSWORD=patient123

VITE_REVIEWER_USERNAME=reviewer_demo
VITE_REVIEWER_PASSWORD=reviewer123

VITE_ADMIN_USERNAME=admin_demo
VITE_ADMIN_PASSWORD=admin123

# Shared secret sent as X-API-Key on every backend request — must match the
# backend's API_KEY (see root .env.example and backend/app/core/auth.py).
VITE_API_KEY=change-me-to-a-random-secret
