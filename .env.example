# Copy to .env and fill in real values. .env is gitignored — never commit it.

# LLM provider used for Intake extraction, Summarizer translation, and
# Peer-Review's rationale layer (never for hard-gate decisions — see CLAUDE.md
# rule 1). One of: gemini | openai | bedrock_claude
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

POSTGRES_USER=agentic_pa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentic_pa
DATABASE_URL=postgresql://agentic_pa:change-me@localhost:5432/agentic_pa

REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379/0

QDRANT_URL=http://localhost:6333
CMS_CONVERSION_FACTOR_2026=33.4009

BACKEND_PORT=8000
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173

# DEMO-MOCKED: hardcoded login credentials, one set per role — no real auth
# backend/session (see CLAUDE.md's auth scope). docker-compose passes these to
# the frontend image as build args (see frontend/Dockerfile) so the deployed
# build uses the same creds as local `npm run dev` (frontend/.env.example).
VITE_PATIENT_USERNAME=patient_demo
VITE_PATIENT_PASSWORD=patient123
VITE_REVIEWER_USERNAME=reviewer_demo
VITE_REVIEWER_PASSWORD=reviewer123
VITE_ADMIN_USERNAME=admin_demo
VITE_ADMIN_PASSWORD=admin123
